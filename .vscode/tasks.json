{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: pub get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "flutter: build runner (build)",
      "type": "shell",
      "command": "flutter pub run build_runner build --delete-conflicting-outputs",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "flutter: build runner (watch)",
      "type": "shell",
      "command": "flutter pub run build_runner watch --delete-conflicting-outputs",
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "flutter: clean",
      "type": "shell",
      "command": "flutter clean",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "flutter: build web",
      "type": "shell",
      "command": "flutter build web --release",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "flutter: analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "flutter: format",
      "type": "shell",
      "command": "dart format .",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
